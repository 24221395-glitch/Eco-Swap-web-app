# Copy to .env and fill in real values. Never commit .env.
# --- Database (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/ecoswap_db?serverTimezone=UTC&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=ecoswap
DB_PASSWORD=

# --- First administrator (created once at startup if no account with this e-mail exists) ---
ECOSWAP_ADMIN_EMAIL=
ECOSWAP_ADMIN_PASSWORD=
ECOSWAP_ADMIN_NAME=EcoSwape Administrator

# --- Application ---
SPRING_PROFILES_ACTIVE=dev
ECOSWAP_BASE_URL=http://localhost:8080
ECOSWAP_TIME_ZONE=Asia/Kuala_Lumpur
ECOSWAP_STORAGE_DIR=./storage
# Long random string; keeps "remember me" logins valid across restarts.
ECOSWAP_REMEMBER_ME_KEY=
# Comma-separated university e-mail domains allowed to register, e.g. siswa.um.edu.my,um.edu.my (empty = any)
ECOSWAP_ALLOWED_EMAIL_DOMAINS=
ECOSWAP_REQUIRE_EMAIL_VERIFICATION=false

# --- E-mail (optional). Without SPRING_MAIL_HOST, links are written to the application log instead. ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
ECOSWAP_MAIL_FROM=Eco Swape <no-reply@example.edu>

# --- Production only ---
SESSION_COOKIE_SECURE=false

# --- Tests (mvn verify) ---
TEST_DB_URL=jdbc:mysql://localhost:3306/ecoswap_test?serverTimezone=UTC&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
TEST_DB_USERNAME=ecoswap
TEST_DB_PASSWORD=
